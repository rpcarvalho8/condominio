{
  "name": "@template/web",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/api/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "bun run build && vite preview",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:migrate:reuniao-segments": "bun --env-file=../../.env run scripts/migrate-reuniao-recording-segments.ts",
    "db:migrate:kernel": "bun --env-file=../../.env run scripts/migrate-domain-kernel.ts",
    "db:migrate:platform": "bun --env-file=../../.env run scripts/migrate-tenant-directory.ts",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "test:reuniao": "bun test src/api/lib/reuniao-recording.test.ts src/api/lib/reuniao-recording.integration.test.ts",
    "test:kernel": "bun test src/api/domain/roles.test.ts src/api/application/auth/legacy-user-role-adapter.test.ts src/api/kernel.integration.test.ts",
    "test:platform": "bun test src/api/platform.integration.test.ts",
    "test:f0": "bun run test:kernel && bun run test:platform",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "import:excel-2026": "bun run scripts/import-excel-2026.ts",
    "db:setup-local": "bun run scripts/setup-local-db.ts",
    "seed:quotas-extras": "bun --env-file=../../.env run src/api/database/seed-quotas-extras.ts",
    "seed:fracoes": "bun --env-file=../../.env run src/api/database/seed-fracoes.ts",
    "fix:proprietarios": "bun --env-file=../../.env run scripts/fix-proprietarios-fracoes.ts",
    "ensure:pagador-perfis": "bun --env-file=../../.env run scripts/ensure-pagador-perfis.ts",
    "reconcile:passo2": "bun --env-file=../../.env run scripts/reconcile-passo2-aliases-rateio.ts",
    "seed:gdpr-config": "bun --env-file=../../.env run src/api/database/seed-gdpr-config.ts",
    "seed:ancora": "bun --env-file=../../.env run src/api/database/seed-ancora.ts",
    "smoke:db": "bun --env-file=../../.env run scripts/smoke-db-check.ts",
    "test:imap": "bun --env-file=../../.env run scripts/test-imap.ts",
    "postinstall": "bun scripts/ensure-puppeteer-chrome.ts",
    "pdf:install-browser": "bun scripts/ensure-puppeteer-chrome.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@runablehq/website-runtime": "^0.10.0",
    "@tanstack/react-query": "^5.100.6",
    "better-auth": "1.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.12.10",
    "imapflow": "^1.7.1",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.15",
    "puppeteer": "^25.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "wouter": "^3.9.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/jsdom": "^28.0.1",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.3.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.0.3",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.3.1"
  }
}
