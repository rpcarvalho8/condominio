# Environment
NODE_ENV=development

# CI only: skip Puppeteer Chromium download during `bun install` (~170–300 MB).
# Do not set this on developer or production machines.
# PUPPETEER_SKIP_DOWNLOAD=1
WEBSITE_URL=http://localhost:4200

# Testes iPad via Cloudflare Tunnel (quick tunnel / trycloudflare).
# A URL https://xxxx.trycloudflare.com muda a cada sessão — não a deixes permanente no .env.
# Fluxo: bun run dev  →  cloudflared tunnel --url http://localhost:4200
#        → copia a URL HTTPS  →  actualiza WEBSITE_URL  →  reinicia bun run dev
# WEBSITE_URL=https://xxxx.trycloudflare.com

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# LLM Fallback (Camada 2 — identificação de transações)
GROQ_API_KEY=
# Opcional — defaults no código: openai/gpt-oss-120b / openai/gpt-oss-20b / qwen/qwen3.6-27b
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_CHAT_MODEL_FAST=openai/gpt-oss-20b
# GROQ_CHAT_MODEL_FALLBACK=qwen/qwen3.6-27b
OPENROUTER_API_KEY=

# Notificação de novos pedidos (opcional — default: urbanizacaofonte@gmail.com)
# ADMIN_NOTIFY_EMAIL=urbanizacaofonte@gmail.com

# Inbox Gmail (IMAP) — desactivado se GMAIL_APP_PASSWORD estiver vazio
# Conta Google → Segurança → Palavras-passe de app → "Correio"
GMAIL_USER=urbanizacaofonte@gmail.com
GMAIL_APP_PASSWORD=     # Palavra-passe de app Google (sem espaços)
EMAIL_INGEST_SECRET=    # Opcional: protege webhook POST /api/email-inbox/ingest
