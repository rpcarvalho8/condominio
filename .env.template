# Environment
NODE_ENV=development

# CI only: skip Puppeteer Chromium download during `bun install` (~170–300 MB).
# Do not set this on developer or production machines.
# PUPPETEER_SKIP_DOWNLOAD=1
WEBSITE_URL=http://localhost:4200

# Testes iPad via Cloudflare Tunnel (quick tunnel / trycloudflare).
# A URL https://xxxx.trycloudflare.com muda a cada sessão — não a deixes permanente no .env.
# Fluxo: bun run dev  →  cloudflared tunnel --url http://localhost:4200
#        → copia a URL HTTPS  →  actualiza WEBSITE_URL  →  reinicia bun run dev
# WEBSITE_URL=https://xxxx.trycloudflare.com

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso) — BD do tenant Fonte (legado até multi-DB runtime)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Platform DB — TenantDirectory (fora das BDs de tenant). Default local: file:./platform.db
# PLATFORM_DATABASE_URL=file:./platform.db
# PLATFORM_DATABASE_AUTH_TOKEN=
# TENANT_DB_ROOT=./data/tenants
# PLATFORM_ENFORCE_DIRECTORY=1   # kernel paths exigem tenant activo no directory
# PROVISION_TEST_TENANT=1        # migrate-tenant-directory cria segundo DB de teste
# TEST_TENANT_ID=lumen-test-tenant
# TENANT_ID=901932027            # omissão = NIF do condomínio Fonte em condominio.ts

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# Object storage (F1) — default local (dev/CI). Staging/prod: driver s3 + S3_*.
# Fail-closed se OBJECT_STORAGE_DRIVER=s3 sem credenciais. CI NÃO define o driver s3.
# OBJECT_STORAGE_DRIVER=local
# CONTENT_BLOB_ROOT=
#
# Staging / produção (S3-compatible: AWS, R2, MinIO, Spaces):
# OBJECT_STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=lumen-staging
# Path-style (default, S3-compatible). AWS virtual-hosted: S3_VIRTUAL_HOSTED_STYLE=1
# S3_FORCE_PATH_STYLE=1
# Smoke real (nunca em CI): OBJECT_STORAGE_LIVE_S3=1
# Cutover: ligar S3 ANTES de ingestão real. Não copia blobs locais existentes.
#
# Local MinIO (dev only) — NÃO staging/prod. Credenciais dummy. Path-style.
# docker compose -f docker-compose.minio.yml up -d
# ./scripts/dev-minio-smoke.sh
# OBJECT_STORAGE_DRIVER=s3
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=lumen-dev
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_KEY_PREFIX=lumen-dev
# S3_FORCE_PATH_STYLE=1
# OBJECT_STORAGE_LIVE_S3=1

# F1 OCR/LLM (opcional). CI usa stub determinístico — não definir em testes.
# F1_OCR_ENDPOINT=
# F1_OCR_API_KEY=
# Hipótese Groq no pipeline de ingestão F1. Omisso = 0. Não confirma permilagens.
# F1_LLM_EXTRACT=0

# LLM Fallback (Camada 2 — identificação de transações)
GROQ_API_KEY=
# Opcional — defaults no código: openai/gpt-oss-120b / openai/gpt-oss-20b / qwen/qwen3.6-27b
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_CHAT_MODEL_FAST=openai/gpt-oss-20b
# GROQ_CHAT_MODEL_FALLBACK=qwen/qwen3.6-27b
OPENROUTER_API_KEY=

# Notificação de novos pedidos (opcional — default: urbanizacaofonte@gmail.com)
# ADMIN_NOTIFY_EMAIL=urbanizacaofonte@gmail.com

# Inbox Gmail (IMAP) — desactivado se GMAIL_APP_PASSWORD estiver vazio
# Conta Google → Segurança → Palavras-passe de app → "Correio"
GMAIL_USER=urbanizacaofonte@gmail.com
GMAIL_APP_PASSWORD=     # Palavra-passe de app Google (sem espaços)
EMAIL_INGEST_SECRET=    # Opcional: protege webhook POST /api/email-inbox/ingest
